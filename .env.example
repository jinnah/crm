# Copy to .env for Docker Compose, or to api/.env for running the API outside Docker.
# Safe local-development placeholders only. Never commit real credentials.

# PostgreSQL (Docker Compose)
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm-dev-password
POSTGRES_DB=crm

# API
# Outside Docker the database host is localhost; inside Docker Compose it is "db".
DATABASE_URL=postgresql+psycopg://crm:crm-dev-password@localhost:5432/crm
# development | test | production
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Authentication
# Production requires a generated secret (the API refuses to start otherwise):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_TOKEN_PEPPER=dev-only-pepper-not-for-production
# Must be true in production (HTTPS); false only for local HTTP development.
SESSION_COOKIE_SECURE=false
# Public frontend URL used for password-reset links and Origin validation.
FRONTEND_URL=http://localhost:3000

# Server-side API key for the n8n inbound-event endpoint (/api/v1/inbound/events).
# Empty disables the endpoint. Generate a real key outside source control:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INBOUND_API_KEY=

# Transactional SMTP for password-recovery email (separate from the future CRM
# email integration). Leave SMTP_HOST empty to disable sending in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
# starttls | ssl | none
SMTP_TLS=starttls

# Frontend (NEXT_PUBLIC_ variables are exposed to the browser — never put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:8000
