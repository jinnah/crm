# Copy to .env for Docker Compose, or to api/.env for running the API outside Docker.
# Safe local-development placeholders only. Never commit real credentials.

# PostgreSQL (Docker Compose)
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm-dev-password
POSTGRES_DB=crm

# API
# Outside Docker the database host is localhost; inside Docker Compose it is "db".
DATABASE_URL=postgresql+psycopg://crm:crm-dev-password@localhost:5432/crm
# development | test | production
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]

# Authentication
# Production requires a generated secret (the API refuses to start otherwise):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_TOKEN_PEPPER=dev-only-pepper-not-for-production
# Must be true in production (HTTPS); false only for local HTTP development.
SESSION_COOKIE_SECURE=false
# Public frontend URL used for password-reset links and Origin validation.
FRONTEND_URL=http://localhost:3000

# Server-side API key for the n8n inbound-event endpoint (/api/v1/inbound/events).
# Empty disables the endpoint. Generate a real key outside source control:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INBOUND_API_KEY=

# Server-only credential the Next.js BFF presents on the CRM's internal
# capability endpoints (/api/v1/internal/*). Empty disables those endpoints.
# NEVER expose this as NEXT_PUBLIC_*. Generate like the inbound key.
INTERNAL_BFF_KEY=

# Dedicated rotatable key for the voice-ingestion endpoints
# (/api/v1/inbound/voice-*). Falls back to INBOUND_API_KEY when empty.
VOICE_API_KEY=

# Shared secret the AI voice workflow sends as X-Voice-Secret to the n8n
# voice-complete webhook. Empty rejects every voice completion.
VOICE_INTAKE_SECRET=

# Transactional SMTP for password-recovery email (separate from the future CRM
# email integration). Leave SMTP_HOST empty to disable sending in development.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
# starttls | ssl | none
SMTP_TLS=starttls

# n8n automation (all placeholders; never commit real credentials).
# Editor access is secured by n8n's built-in owner account, created on first
# visit to http://localhost:5678 — there is no basic-auth env option in 2.x.
# Generate the encryption key once per installation:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_ENCRYPTION_KEY=dev-only-n8n-encryption-key
# Public URL n8n webhooks are reachable at (ngrok/production URL in real use).
N8N_WEBHOOK_URL=http://localhost:5678
# n8n public REST API access for n8n/assign-error-workflow.mjs (create the key
# in the n8n editor under Settings -> n8n API; workflow:read + workflow:update
# scopes suffice). Never commit a real key.
N8N_API_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=
# Twilio webhook validation (auth token from the Twilio console).
TWILIO_AUTH_TOKEN=
TWILIO_WEBHOOK_BASE_URL=http://localhost:5678
# Meta (WhatsApp / Messenger) webhook validation.
META_APP_SECRET=
META_VERIFY_TOKEN=
# Optional shared secret the website form sends as X-Form-Secret.
FORM_SHARED_SECRET=

# Outbound SMS: the CRM calls this authenticated n8n workflow, which holds the
# Twilio credentials. Generate the shared secret outside source control.
N8N_SEND_URL=http://n8n:5678/webhook/twilio-send
N8N_SEND_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=
# Leave unset in real use; only local verification points this at a mock.
TWILIO_API_BASE=https://api.twilio.com

# Frontend (NEXT_PUBLIC_ variables are exposed to the browser — never put secrets here)
NEXT_PUBLIC_API_URL=http://localhost:8000
# Server-side only: how the public booking page reaches the CRM from the web
# container. The browser never sees this address.
CRM_API_URL=http://api:8000

# --- Job documents: object storage ------------------------------------
# "local" stores binaries on the documents_data volume (dev default).
# Production: set "s3" plus the bucket/endpoint/credentials for any
# S3-compatible store. These are deployment secrets - never settings rows,
# never NEXT_PUBLIC_*, never workflow JSON.
DOCUMENTS_STORAGE_BACKEND=local
DOCUMENTS_S3_BUCKET=
DOCUMENTS_S3_ENDPOINT_URL=
DOCUMENTS_S3_REGION=
DOCUMENTS_S3_ACCESS_KEY_ID=
DOCUMENTS_S3_SECRET_ACCESS_KEY=
# auto (AWS default) | path | virtual - some S3-compatible providers need "path"
# when DOCUMENTS_S3_ENDPOINT_URL points at a custom endpoint.
DOCUMENTS_S3_ADDRESSING_STYLE=auto

# --- Malware scanning --------------------------------------------------
# Files stay quarantined until a scan succeeds. Development may use "stub"
# (EICAR-only detection); production MUST use "clamd" - start the scanner
# with: docker compose --profile scanning up -d
SCANNER_BACKEND=stub

# --- Transactional document email --------------------------------------
# The ONE verified sender for this installation (verify it with your email
# provider first). Empty disables sending; drafts and PDFs still work.
# Neither users nor API callers can override it.
DOCUMENT_EMAIL_FROM_ADDRESS=
# Key the n8n document-email workflow presents to the claim/report
# endpoints. Falls back to INBOUND_API_KEY when empty. Generate like the
# inbound key.
DOCUMENT_EMAIL_API_KEY=
