      "parameters": {
        "jsCode": "// Selective retry, applied to EVERY attempt: only network errors,\n// timeouts, 429 and 5xx are temporary. A permanent 4xx stops here even\n// when an earlier attempt failed temporarily. Output carries the\n// outcome only.\nconst PERMANENT = [400, 401, 403, 404, 405, 409, 413, 415, 422];\nconst response = $input.all()[0].json;\nconst status = Number(response.statusCode || 0);\n\nif (status >= 200 && status < 300) {\n  const body = response.body && typeof response.body === 'object' ? response.body : {};\n  return [{ json: { outcome: 'success', lead_id: body.lead_id,\n    activity_id: body.activity_id, replayed: body.replayed === true } }];\n}\nif (PERMANENT.includes(status)) {\n  return [{ json: { outcome: 'permanent', status,\n    message: 'CRM rejected the request (' + status + ')' } }];\n}\nreturn [{ json: { outcome: 'retry' } }];\n"
      },
