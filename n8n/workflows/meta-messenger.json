      "id": "wh-meta-messenger-post",
      "name": "Messenger Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "meta-messenger-post"
    },
    {
      "parameters": {
        "jsCode": "// Meta webhook authenticity: X-Hub-Signature-256 is HMAC-SHA256 of the raw\n// request body, keyed with the app secret.\nfunction metaBodyIfValid(item) {\n  const crypto = require('crypto');\n  const headers = item.json.headers || {};\n  const secret = $env.META_APP_SECRET || '';\n  let raw;\n  if (item.binary && item.binary.data && item.binary.data.data) {\n    raw = Buffer.from(item.binary.data.data, 'base64').toString('utf8');\n  } else {\n    raw = JSON.stringify(item.json.body || {});\n  }\n  const provided = headers['x-hub-signature-256'] || '';\n  if (!secret || !provided.startsWith('sha256=')) return null;\n  const expected = 'sha256=' + crypto.createHmac('sha256', secret).update(raw, 'utf8').digest('hex');\n  const a = Buffer.from(expected);\n  const b = Buffer.from(provided);\n  if (a.length !== b.length || !crypto.timingSafeEqual(a, b)) return null;\n  return JSON.parse(raw);\n}\nconst item = $input.all()[0];\nconst payload = metaBodyIfValid(item);\nif (payload === null) {\n  return [{ json: { reject: true, status: 403, message: 'invalid signature' } }];\n}\n\nconst out = [];\nfor (const entry of payload.entry || []) {\n  for (const messaging of entry.messaging || []) {\n    const msg = messaging.message;\n    if (!msg || msg.is_echo) continue; // deliveries, reads, echoes\n    const psid = (messaging.sender && messaging.sender.id) || '';\n    let content = msg.text || null;\n    let eventType = 'message';\n    if (!content) {\n      const kinds = (msg.attachments || []).map((a) => a.type).filter(Boolean).join(', ');\n      content = '[' + (kinds || 'attachment') + ' received - media not stored]';\n      eventType = 'media_message';\n    }\n    out.push({\n      json: {\n        reject: false,\n        idempotency_key: 'meta:facebook:' + msg.mid,\n        event: {\n          channel: 'facebook',\n          provider: 'meta',\n          external_event_id: msg.mid,\n          event_type: eventType,\n          external_sender_id: psid || null,\n          content,\n          received_at: messaging.timestamp\n            ? new Date(messaging.timestamp).toISOString()\n            : new Date().toISOString(),\n          metadata: { page_id: entry.id || null },\n        },\n      },\n    });\n  }\n}\nif (out.length === 0) {\n  return [{ json: { reject: true, status: 200, message: 'no messages' } }];\n}\nreturn out;\n"
      },
