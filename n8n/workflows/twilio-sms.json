      "id": "crm-write-retry",
      "name": "CRM Write Retry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        40
      ],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 2000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Outcome of the bounded synchronous retries. No personal data is emitted.\nconst response = $input.all()[0].json;\nconst status = Number(response.statusCode || 0);\nif (status >= 200 && status < 300) {\n  const body = response.body || {};\n  return [{ json: { outcome: 'success', lead_id: body.lead_id,\n    activity_id: body.activity_id, replayed: body.replayed === true } }];\n}\nreturn [{ json: { outcome: 'exhausted', status: 503,\n  message: 'CRM unavailable after retries' } }];\n"
      },
      "id": "code-classify-retry",
      "name": "Classify Retry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
