      "id": "wh-twilio-sms-post",
      "name": "Twilio SMS Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "twilio-sms-post"
    },
    {
      "parameters": {
        "jsCode": "// Twilio webhook authenticity: HMAC-SHA1 over the public URL plus the\n// alphabetically sorted POST parameters, keyed with the auth token.\nfunction twilioSignatureValid(params, headers, path) {\n  const authToken = $env.TWILIO_AUTH_TOKEN || '';\n  const url = ($env.TWILIO_WEBHOOK_BASE_URL || '') + '/webhook/' + path;\n  const sorted = Object.keys(params).sort().map((k) => k + params[k]).join('');\n  const provided = headers['x-twilio-signature'] || '';\n  if (!authToken || !provided) return false;\n  const expected = crypto.createHmac('sha1', authToken).update(url + sorted, 'utf8').digest('base64');\n  const a = Buffer.from(expected);\n  const b = Buffer.from(provided);\n  return a.length === b.length && crypto.timingSafeEqual(a, b);\n}\nconst crypto = require('crypto');\nconst item = $input.all()[0];\nconst params = item.json.body || {};\nconst headers = item.json.headers || {};\n\nif (!twilioSignatureValid(params, headers, 'twilio-sms')) {\n  return [{ json: { reject: true, status: 403, message: 'invalid signature' } }];\n}\nconst sid = params.MessageSid || params.SmsSid;\nif (!sid || !params.From) {\n  return [{ json: { reject: true, status: 422, message: 'missing MessageSid or From' } }];\n}\nreturn [{\n  json: {\n    reject: false,\n    idempotency_key: 'twilio:sms:' + sid,\n    event: {\n      channel: 'sms',\n      provider: 'twilio',\n      external_event_id: sid,\n      event_type: 'sms_received',\n      sender_phone: params.From,\n      content: params.Body || '(empty SMS)',\n      received_at: new Date().toISOString(),\n      metadata: {\n        to: params.To || null,\n        message_status: params.SmsStatus || params.MessageStatus || null,\n        from_city: params.FromCity || null,\n        from_state: params.FromState || null,\n      },\n    },\n  },\n}];\n"
      },
