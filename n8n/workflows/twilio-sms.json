        }
      },
      "id": "crm-write",
      "name": "CRM Write",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        840,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Selective retry: network errors, timeouts, 429 and 5xx are temporary and\n// worth retrying; 4xx validation/authentication failures are permanent and\n// must never be retried. Only non-personal fields are emitted.\nconst PERMANENT = [400, 401, 403, 404, 405, 409, 413, 415, 422];\n\nconst response = $input.all()[0].json;\nconst request = $('Prepare Attempt').first().json;\nconst status = Number(response.statusCode || 0);\nconst carry = { event: request.event, idempotency_key: request.idempotency_key };\n\nif (status >= 200 && status < 300) {\n  const body = response.body || {};\n  return [{ json: { ...carry, outcome: 'success', lead_id: body.lead_id,\n    activity_id: body.activity_id, replayed: body.replayed === true } }];\n}\nif (PERMANENT.includes(status)) {\n  return [{ json: { ...carry, outcome: 'permanent', status,\n    message: 'CRM rejected the request (' + status + ')' } }];\n}\nreturn [{ json: { ...carry, outcome: 'retry', status } }];\n"
      },
