        "responseBody": "={{ JSON.stringify($json.outcome === 'success' ? {status: 'ok', lead_id: $json.lead_id, activity_id: $json.activity_id, replayed: $json.replayed} : {error: $json.message}) }}",
        "options": {
          "responseCode": "={{ $json.outcome === 'success' ? 200 : 503 }}"
        }
      },
