    {
      "parameters": {
        "jsCode": "// Twilio webhook authenticity: HMAC-SHA1 over the public URL plus the\n// alphabetically sorted POST parameters, keyed with the auth token.\nfunction twilioSignatureValid(params, headers, path) {\n  const authToken = $env.TWILIO_AUTH_TOKEN || '';\n  const url = ($env.TWILIO_WEBHOOK_BASE_URL || '') + '/webhook/' + path;\n  const sorted = Object.keys(params).sort().map((k) => k + params[k]).join('');\n  const provided = headers['x-twilio-signature'] || '';\n  if (!authToken || !provided) return false;\n  const expected = crypto.createHmac('sha1', authToken).update(url + sorted, 'utf8').digest('base64');\n  const a = Buffer.from(expected);\n  const b = Buffer.from(provided);\n  return a.length === b.length && crypto.timingSafeEqual(a, b);\n}\nconst crypto = require('crypto');\nconst item = $input.all()[0];\nconst params = item.json.body || {};\nconst headers = item.json.headers || {};\n\nif (!twilioSignatureValid(params, headers, 'twilio-status')) {\n  return [{ json: { reject: true, status: 403, message: 'invalid signature' } }];\n}\nconst sid = params.MessageSid || params.SmsSid;\nconst status = params.MessageStatus || params.SmsStatus;\nif (!sid || !status) {\n  return [{ json: { reject: true, status: 422, message: 'missing MessageSid or MessageStatus' } }];\n}\nreturn [{\n  json: {\n    reject: false,\n    payload: {\n      provider_sid: sid,\n      status,\n      error_code: params.ErrorCode ? String(params.ErrorCode).slice(0, 32) : null,\n      error_message: params.ErrorMessage ? String(params.ErrorMessage).slice(0, 300) : null,\n    },\n  },\n}];\n"
      },
