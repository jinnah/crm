      "parameters": {
        "jsCode": "// Every attempt is classified. A CRM 2xx (including the normal\n// matched:false result for a SID we do not track) is success; a\n// permanent 4xx stops immediately even after an earlier temporary\n// failure; only network errors, timeouts, 429 and 5xx retry.\nconst PERMANENT = [400, 401, 403, 404, 405, 409, 413, 415, 422];\nconst response = $input.all()[0].json;\nconst status = Number(response.statusCode || 0);\n\nif (status >= 200 && status < 300) {\n  return [{ json: { outcome: 'success' } }];\n}\nif (PERMANENT.includes(status)) {\n  return [{ json: { outcome: 'permanent', status,\n    message: 'CRM rejected the status callback' } }];\n}\nreturn [{ json: { outcome: 'retry' } }];\n"
      },
