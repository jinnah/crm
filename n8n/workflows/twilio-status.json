              "value": "={{ $env.CRM_INBOUND_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 15000
        }
      },
      "id": "crm-status-write",
      "name": "CRM Status Update",
      "type": "n8n-nodes-base.httpRequest",
