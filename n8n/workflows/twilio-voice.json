      "parameters": {
        "jsCode": "// Twilio webhook authenticity: HMAC-SHA1 over the public URL plus the\n// alphabetically sorted POST parameters, keyed with the auth token.\nfunction twilioSignatureValid(params, headers, path) {\n  const authToken = $env.TWILIO_AUTH_TOKEN || '';\n  const url = ($env.TWILIO_WEBHOOK_BASE_URL || '') + '/webhook/' + path;\n  const sorted = Object.keys(params).sort().map((k) => k + params[k]).join('');\n  const provided = headers['x-twilio-signature'] || '';\n  if (!authToken || !provided) return false;\n  const expected = crypto.createHmac('sha1', authToken).update(url + sorted, 'utf8').digest('base64');\n  const a = Buffer.from(expected);\n  const b = Buffer.from(provided);\n  return a.length === b.length && crypto.timingSafeEqual(a, b);\n}\nconst crypto = require('crypto');\nconst item = $input.all()[0];\nconst params = item.json.body || {};\nconst headers = item.json.headers || {};\n\nif (!twilioSignatureValid(params, headers, 'twilio-voice')) {\n  return [{ json: { reject: true, status: 403, message: 'invalid signature' } }];\n}\nconst callSid = params.CallSid;\nif (!callSid) {\n  return [{ json: { reject: true, status: 422, message: 'missing CallSid' } }];\n}\n\nconst status = params.CallStatus || '';\nlet eventType = 'call_status';\nlet suffix = 'status:' + (status || 'unknown');\nlet content;\nif (params.TranscriptionSid) {\n  eventType = 'voicemail_transcription';\n  suffix = 'transcription:' + params.TranscriptionSid;\n  content = 'Voicemail transcription: ' + (params.TranscriptionText || '(unavailable)');\n} else if (params.RecordingSid) {\n  eventType = 'voicemail';\n  suffix = 'recording:' + params.RecordingSid;\n  // A reference only — recordings are not downloaded or stored.\n  content = 'Voicemail recorded (' + (params.RecordingDuration || '?') + 's). Recording reference: ' + params.RecordingSid;\n} else if (['no-answer', 'busy', 'failed', 'canceled'].includes(status)) {\n  eventType = 'missed_call';\n  content = 'Missed call (' + status + ') from ' + (params.From || 'unknown number');\n} else if (status === 'completed') {\n  eventType = 'call_completed';\n  content = 'Call completed. Duration: ' + (params.CallDuration || '?') + 's';\n} else {\n  content = 'Call event: ' + (status || 'unknown');\n}\n\nreturn [{\n  json: {\n    reject: false,\n    idempotency_key: 'twilio:call:' + callSid + ':' + suffix,\n    event: {\n      channel: 'phone_call',\n      provider: 'twilio',\n      external_event_id: callSid + ':' + suffix,\n      event_type: eventType,\n      sender_phone: params.From || null,\n      content,\n      received_at: new Date().toISOString(),\n      metadata: {\n        to: params.To || null,\n        call_status: status || null,\n        duration_seconds: params.CallDuration || null,\n        recording_sid: params.RecordingSid || null,\n        direction: params.Direction || null,\n      },\n    },\n  },\n}];\n"
      },
