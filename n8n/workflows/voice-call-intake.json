    {
      "parameters": {
        "jsCode": "// Selective retry on EVERY attempt: only network errors, timeouts,\n// 429 and 5xx retry. A permanent 4xx (including the 409 identity\n// conflict) stops immediately. Output carries the outcome only.\nconst PERMANENT = [400, 401, 403, 404, 405, 409, 413, 415, 422];\nconst response = $input.all()[0].json;\nconst status = Number(response.statusCode || 0);\n\nif (status >= 200 && status < 300) {\n  const body = response.body && typeof response.body === 'object' ? response.body : {};\n  return [{ json: { outcome: 'success', lead_id: body.lead_id,\n    call_id: body.call_id, replayed: body.replayed === true } }];\n}\nif (PERMANENT.includes(status)) {\n  return [{ json: { outcome: 'permanent', status,\n    message: 'CRM rejected the call completion (' + status + ')' } }];\n}\nreturn [{ json: { outcome: 'retry' } }];\n"
      },
