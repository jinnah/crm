      "id": "wh-voice-complete-post",
      "name": "Voice Completion Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "voice-complete-post"
    },
    {
      "parameters": {
        "jsCode": "// Structured completion from the AI voice workflow (provider-neutral).\n// Validates the shared secret, maps the documented fields onto the CRM\n// schema, and emits nothing sensitive beyond the normalized event itself.\nconst crypto = require('crypto');\nconst item = $input.all()[0];\nconst body = item.json.body || {};\nconst headers = item.json.headers || {};\n\nconst expected = $env.VOICE_INTAKE_SECRET || '';\nconst provided = headers['x-voice-secret'] || '';\nif (!expected || !provided || provided.length !== expected.length ||\n    !crypto.timingSafeEqual(Buffer.from(provided), Buffer.from(expected))) {\n  return [{ json: { reject: true, status: 401, message: 'unauthorized' } }];\n}\n\nconst sid = String(body.call_sid || '').trim();\nif (sid.length < 8 || sid.length > 64) {\n  return [{ json: { reject: true, status: 422, message: 'call_sid is required' } }];\n}\n\nfunction bounded(value, limit) {\n  return value === undefined || value === null ? '' : String(value).slice(0, limit);\n}\nfunction boundedOrNull(value, limit) {\n  const text = bounded(value, limit);\n  return text === '' ? null : text;\n}\nconst oneOf = (value, allowed, fallback) =>\n  allowed.includes(value) ? value : fallback;\n\n// Only the documented fields travel onward; anything else the upstream\n// workflow sends is dropped here rather than reaching the CRM.\nconst event = {\n  provider: bounded(body.provider, 32) || 'twilio',\n  call_sid: sid,\n  caller_phone: boundedOrNull(body.caller_phone, 32),\n  business_phone: boundedOrNull(body.business_phone, 32),\n  started_at: boundedOrNull(body.started_at, 40),\n  answered_at: boundedOrNull(body.answered_at, 40),\n  ended_at: boundedOrNull(body.ended_at, 40),\n  duration_seconds: Number.isFinite(Number(body.duration_seconds))\n    ? Math.max(0, Math.min(21600, Math.trunc(Number(body.duration_seconds))))\n    : null,\n  call_status: oneOf(body.call_status,\n    ['completed', 'no_answer', 'abandoned', 'transferred', 'failed'], 'completed'),\n  disposition: bounded(body.disposition, 64),\n  caller_name: bounded(body.caller_name, 200),\n  caller_email: boundedOrNull(body.caller_email, 320),\n  service_requested: bounded(body.service_requested, 300),\n  service_address: bounded(body.service_address, 300),\n  preferred_callback_window: bounded(body.preferred_callback_window, 200),\n  appointment_preference: bounded(body.appointment_preference, 200),\n  summary: bounded(body.summary, 2000),\n  urgency: oneOf(body.urgency, ['normal', 'urgent'], 'normal'),\n  requires_human_follow_up: body.requires_human_follow_up === true,\n  transfer_outcome: oneOf(body.transfer_outcome, ['none', 'completed', 'failed'], 'none'),\n  disclosure_version: bounded(body.disclosure_version, 64),\n  consent_result: oneOf(body.consent_result, ['granted', 'declined', 'not_asked'], 'not_asked'),\n  recording_sid: boundedOrNull(body.recording_sid, 64),\n  transcript_text: boundedOrNull(body.transcript_text, 20000),\n};\n\nreturn [{ json: { reject: false, event } }];\n"
      },
