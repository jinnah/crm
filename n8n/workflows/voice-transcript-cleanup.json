{
  "name": "Voice Transcript Cleanup",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 3
            }
          ]
        }
      },
      "id": "cleanup-schedule",
      "name": "Daily At 03:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Counts only: what the sweep removed, never whose calls were touched.\nconst response = $input.all()[0].json;\nconst body = response.body && typeof response.body === 'object' ? response.body : {};\nreturn [{\n  json: {\n    outcome: 'swept',\n    purged_transcripts: Number(body.purged_transcripts || 0),\n    purged_recordings: Number(body.purged_recordings || 0),\n    ran_at: new Date().toISOString(),\n  },\n}];\n"
      },
      "id": "code-summarize-sweep",
      "name": "Summarize Sweep",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2540,
        -200
      ]
    },
    {
      "parameters": {
        "jsCode": "// The CRM could not be reached; the sweep simply runs again tomorrow.\nconst item = $input.all()[0].json;\nreturn [{\n  json: {\n    outcome: 'not_swept',\n    status: Number(item.status || 0) || null,\n    message: String(item.message || 'The CRM did not accept the sweep.').slice(0, 300),\n    ran_at: new Date().toISOString(),\n  },\n}];\n"
      },
      "id": "code-give-up-until-tomorrow",
      "name": "Give Up Until Tomorrow",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2540,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.CRM_API_URL }}/api/v1/inbound/voice-calls/cleanup",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.CRM_VOICE_API_KEY || $env.CRM_INBOUND_API_KEY }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 60000
        }
      },
      "id": "crm-cleanup-1",
      "name": "CRM Cleanup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Every attempt is classified. Output carries the outcome and a\n// bounded message only — never the dispatch body.\nconst PERMANENT = [400, 401, 403, 404, 405, 409, 413, 415, 422];\nconst response = $input.all()[0].json;\nconst status = Number(response.statusCode || 0);\n\nif (status >= 200 && status < 300) {\n  return [{ json: { outcome: 'success' } }];\n}\nif (PERMANENT.includes(status)) {\n  return [{ json: { outcome: 'permanent', status,\n    message: 'The CRM rejected the dispatch (' + status + ')' } }];\n}\nreturn [{ json: { outcome: 'retry' } }];\n"
      },
      "id": "code-classify-cleanup",
      "name": "Classify Cleanup",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        420,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.outcome }}",
                    "rightValue": "success",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "success"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "version": 2
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.outcome }}",
                    "rightValue": "retry",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "retry"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "failed"
        }
      },
